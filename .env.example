# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实密钥。
# flux 启动时从当前目录向上找第一个 .env；已设置的环境变量优先于本文件。

# DeepSeek API 密钥（--engine deepseek 必需）。值里不要有空格或引号。
DEEPSEEK_API_KEY=

# Host 数据目录（可选）。省略时 Windows 用 %LOCALAPPDATA%\FluxAxiom，
# 其它平台用 $XDG_DATA_HOME/fluxaxiom 或 ~/.local/share/fluxaxiom。
# FLUXAXIOM_DATA_DIR=
