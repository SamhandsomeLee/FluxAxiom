{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attempt.schema.json",
  "title": "Attempt",
  "description": "P0a draft. schema_version 0.3-draft is not Contract v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "run_id",
    "engine_id",
    "engine_version",
    "owner",
    "lease_expires_at",
    "status",
    "outcome",
    "error_reason"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "engine_id": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "lease_expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "status": { "enum": ["Starting", "Running", "Ended", "Orphaned"] },
    "outcome": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["completed", "failed", "cancelled"] }
      ]
    },
    "error_reason": {
      "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1 }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "Ended" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "outcome": { "enum": ["completed", "failed", "cancelled"] } }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["Starting", "Running", "Orphaned"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "outcome": { "type": "null" } }
      }
    }
  ]
}
