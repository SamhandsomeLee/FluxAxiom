{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.schema.json",
  "title": "Artifact",
  "description": "P0a draft. schema_version 0.3-draft is not Contract v1. Summary is not file contents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "run_id",
    "artifact_type",
    "storage_ref",
    "summary",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact_type": { "type": "string", "minLength": 1 },
    "storage_ref": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
